  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\uC0C1\uC790\uB97C \uC9C0\uCF1C\uC8FC\uC138\uC694!\nCraft\uB85C \uBB34\uAE30\uB97C
    \uB9CC\uB4E4\uC5B4\uC11C, \uCE5C\uAD6C\uB4E4\uC5D0\uAC8C \uC950\uC5EC\uC8FC\uC138\uC694.
    \n\uCE5C\uAD6C\uAC00 \uC0AC\uB9DD\uD558\uBA74 \uBB34\uAE30\uAC00 \uB3CC\uC544\uC635\uB2C8\uB2E4!\n\uB9CC\uB4E0
    \uBB34\uAE30\uB97C \uD074\uB9AD\uD574\uC11C \uC5C5\uADF8\uB808\uC774\uB4DC \uD560
    \uC218 \uC788\uC2B5\uB2C8\uB2E4!\n\uB9C8\uB9C8\uB294 \uADE0\uD615\uC7A1\uD788\uACE0,
    \uD551\uD551\uC774\uB294 \uD2BC\uD2BC\uD558\uC9C0\uB9CC \uB290\uB9AC\uACE0, \uAD74\uAD74\uC774\uB294
    \uC57D\uD558\uC9C0\uB9CC \uBE60\uB985\uB2C8\uB2E4.\n\n\uC67C\uCABD \uC544\uB798\uC5D0
    \uC788\uB294 \uD0C0\uC6CC\uB294 \uAE38\uC774 \uC544\uB2CC \uC704\uCABD\uC5D0
    \uAC74\uC124\uD560 \uC218 \uC788\uC2B5\uB2C8\uB2E4!\n\uAC01\uAC01\uC758 \uD3EC\uD0D1\uC740
    \uAC15\uB825\uD55C \uC131\uB2A5\uC744 \uC9C0\uB2C8\uACE0 \uC788\uC2B5\uB2C8\uB2E4.
    \n\nD\uB97C \uB20C\uB7EC\uC11C \uC0AC\uAC70\uB9AC \uD45C\uC2DC\uB85C \uB4E4\uC5B4\uAC08
    \uC218 \uC788\uC2B5\uB2C8\uB2E4. \n\n*Turret\uC758 \uACBD\uC6B0\uC5D0\uB294 \uBB34\uAE30\uB97C
    \uC950\uC5EC\uC904 \uC218 \uC788\uC2B5\uB2C8\uB2E4. \uB2E4\uB9CC, \uBB34\uAE30\uB294
    \uC0AC\uB77C\uC9D1\uB2C8\uB2E4. \n\n "
  m_isRightToLeft: 0
